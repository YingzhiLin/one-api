[Unit]
Description=One API with optional FreeIPA authentication
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=one-api
Group=one-api
WorkingDirectory=/opt/one-api
ExecStart=/opt/one-api/one-api --log-dir /var/log/one-api
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0027

StateDirectory=one-api
StateDirectoryMode=0750
LogsDirectory=one-api
LogsDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/one-api /var/log/one-api

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
