PORT=3000
DEBUG=false
HTTPS_PROXY=http://localhost:7890

# Empty SQL_DSN selects SQLite; relative paths are resolved from the project root.
SQL_DSN=
SQLITE_PATH=./one-api.db

# New public registrations can be disabled at deployment time.
REGISTER_ENABLED=true
# IPA_ONLY=true forces IPA authentication and disables all non-IPA account creation/login.
IPA_ENABLED=false
IPA_ONLY=false
IPA_URL=ldaps://ipa.example.com:636
IPA_BASE_DN=dc=example,dc=com
# Defaults to IPA_BASE_DN when not set.
IPA_USER_BASE_DN=cn=users,cn=accounts,dc=example,dc=com
# Match IPA uid values: h* selects accounts starting with h; * selects all.
# Only * is a wildcard. The bind service account is always excluded.
IPA_USER_MATCH=*
# Membership in this direct group grants One API administrator privileges.
IPA_ADMIN_GROUP_DN=cn=one-api-admins,cn=groups,cn=accounts,dc=example,dc=com
# Optional: this group receives One API super-administrator (root) privileges.
IPA_ROOT_GROUP_DN=
# Read-only LDAP bind account; recommended for complete directory listing.
IPA_BIND_DN=uid=one-api-reader,cn=sysaccounts,cn=etc,dc=example,dc=com
IPA_BIND_PASSWORD=
IPA_STARTTLS=false
# Optional PEM CA bundle. In Docker Compose, place it in IPA_CA_CERT_HOST_DIR
# and set IPA_CA_CERT=/run/one-api/certs/ipa-ca.crt. Empty uses system trust.
IPA_CA_CERT=
IPA_CA_CERT_HOST_DIR=./certs
# Refresh IPA user membership and account lock state every 5 minutes.
IPA_SYNC_FREQUENCY=300
